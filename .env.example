# Neon — Postgres (projeto mglabs, branch production)
DATABASE_URL=                 # connection string pooled (host com -pooler) — usada pelo app
DATABASE_URL_UNPOOLED=        # conexão direta — só para migrations (drizzle-kit)

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=           # URL do Auth do branch (inclui /neondb/auth)
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=      # openssl rand -base64 32 (32+ caracteres)

# Acesso (recomendado): só este e-mail vira proprietário no primeiro acesso.
# Sem isso, o PRIMEIRO usuário a entrar após a migration assume o espaço de trabalho.
OWNER_EMAIL=

# Radar
NEXT_PUBLIC_MAP_TILES=        # opcional: tiles raster {z}/{x}/{y}; padrão = OpenStreetMap (https://tile.openstreetmap.org/{z}/{x}/{y}.png)
NEXT_PUBLIC_MAP_STYLE=        # opcional: estilo vetorial MapLibre completo (substitui os tiles do OSM)
OVERTURE_DATA_URL=            # opcional: padrão = branch data-overture do repositório
PAGESPEED_API_KEY=            # opcional: velocidade do site da empresa
CRON_SECRET=                  # openssl rand -hex 24
BOT_CONTACT_EMAIL=            # aparece no User-Agent do robô que lê os sites

# IA opcional (Gemini). Sem a chave, o app inteiro funciona com modelos e escrita manual.
GEMINI_API_KEY=               # só servidor; crie em aistudio.google.com
GEMINI_MODEL=gemini-3.5-flash-lite   # confira o modelo e as cotas gratuitas da sua conta em aistudio.google.com/rate-limit
GEMINI_DAILY_LIMIT=60         # teto de chamadas de IA por dia (todas as funções)
GEMINI_ENABLED=true           # false desliga a IA mesmo com a chave

# Nome usado nas mensagens ({{remetente}})
MEU_NOME=Miguel
