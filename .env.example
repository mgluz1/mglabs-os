# Neon — Postgres (projeto mglabs, branch production)
DATABASE_URL=                 # connection string pooled (host com -pooler) — usada pelo app
DATABASE_URL_UNPOOLED=        # conexão direta — só para migrations (drizzle-kit)

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=           # URL do Auth do branch (inclui /neondb/auth)
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=      # openssl rand -base64 32 (32+ caracteres)

# Radar
NEXT_PUBLIC_MAP_STYLE=        # opcional: estilo MapLibre; padrão https://tiles.openfreemap.org/styles/dark
OVERTURE_DATA_URL=            # opcional: padrão = branch data-overture do repositório
PAGESPEED_API_KEY=            # opcional: velocidade do site da empresa
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
CRON_SECRET=
MEU_NOME=Miguel
BOT_CONTACT_EMAIL=            # aparece no User-Agent do robô que lê os sites
